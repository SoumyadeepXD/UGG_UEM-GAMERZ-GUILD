# ==========================================
# UGG (UEMK Gamerz Guild) Environment Config
# Copy to .env.local for local development
# Configure in Vercel Project Settings for production
# ==========================================

# Base Site URL (used for canonical URLs, OpenGraph, sitemaps)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Public API (Accessible by client and server)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Server-Only Service Role Key (STRICTLY PRIVATE - Never prefix with NEXT_PUBLIC_)
# Used for server-side audit logs, privileged admin verifications, and automated tasks.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Authorized Coordinator Admin Emails (comma-separated, case-insensitive)
ADMIN_EMAILS="gamerzguild@uem.edu.in,coordinator@uem.edu.in"
